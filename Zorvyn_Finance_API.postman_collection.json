{
	"info": {
		"_postman_id": "7dc4faae-9e8c-4467-9c91-9e8e5e8e5e8e",
		"name": "Zorvyn Finance API (Full Sync)",
		"description": "Exhaustive API Collection for Zorvyn Finance app, fully synchronized with Swagger documentation.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"body": { "mode": "raw", "raw": "{\n    \"name\": \"Admin User\",\n    \"email\": \"admin@zorvyn.com\",\n    \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } },
						"url": "{{baseUrl}}/api/auth/register"
					}
				},
				{
					"name": "Login User",
					"event": [ { "listen": "test", "script": { "exec": [ "const res = pm.response.json();", "if(res.success && res.data) {", "  pm.environment.set('accessToken', res.data.accessToken);", "  pm.environment.set('refreshToken', res.data.refreshToken);", "}" ], "type": "text/javascript" } } ],
					"request": {
						"method": "POST",
						"body": { "mode": "raw", "raw": "{\n    \"email\": \"admin@zorvyn.com\",\n    \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } },
						"url": "{{baseUrl}}/api/auth/login"
					}
				},
				{
					"name": "Refresh Token",
					"event": [ { "listen": "test", "script": { "exec": [ "const res = pm.response.json();", "if(res.success && res.data) {", "  pm.environment.set('accessToken', res.data.accessToken);", "  pm.environment.set('refreshToken', res.data.refreshToken);", "}" ], "type": "text/javascript" } } ],
					"request": {
						"method": "POST",
						"body": { "mode": "raw", "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } },
						"url": "{{baseUrl}}/api/auth/refresh"
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"body": { "mode": "raw", "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } },
						"url": "{{baseUrl}}/api/auth/logout"
					}
				},
				{
					"name": "Logout All Devices",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/auth/logout-all"
					}
				}
			]
		},
		{
			"name": "2. User Management (Admin)",
			"item": [
				{ "name": "Get All Users", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/users?page=1&limit=10&search=&role=&status=", "query": [ { "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "search", "value": "" }, { "key": "role", "value": "" }, { "key": "status", "value": "" } ] } } },
				{ "name": "Create User", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\n    \"name\": \"New User\",\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\",\n    \"role\": \"VIEWER\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/users" } },
				{ "name": "Get User By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{activeUserId}}" } },
				{ "name": "Update User", "request": { "method": "PUT", "body": { "mode": "raw", "raw": "{\n    \"role\": \"ANALYST\",\n    \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/users/{{activeUserId}}" } },
				{ "name": "Delete User (Soft)", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/users/{{activeUserId}}" } }
			]
		},
		{
			"name": "3. Financial Records",
			"item": [
				{ "name": "List Records (Filtered)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/records?page=1&limit=10&search=&type=&category=&startDate=&endDate=", "query": [ { "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "search", "value": "" }, { "key": "type", "value": "INCOME" }, { "key": "category", "value": "" }, { "key": "startDate", "value": "" }, { "key": "endDate", "value": "" } ] } } },
				{ "name": "Create Record (Admin Only)", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\n    \"amount\": 5000,\n    \"type\": \"INCOME\",\n    \"category\": \"Salary\",\n    \"date\": \"2024-03-20\",\n    \"notes\": \"March paycheck\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/records" } },
				{ "name": "Get Record By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/records/{{activeRecordId}}" } },
				{ "name": "Update Record (Admin Only)", "request": { "method": "PUT", "body": { "mode": "raw", "raw": "{\n    \"amount\": 5500\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/records/{{activeRecordId}}" } },
				{ "name": "Delete Record (Admin Only)", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/records/{{activeRecordId}}" } }
			]
		},
		{
			"name": "4. Dashboard",
			"item": [
				{ "name": "Get Dashboard Summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/summary" } }
			]
		}
	],
	"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{accessToken}}", "type": "string" } ] },
	"variable": [
		{ "key": "baseUrl", "value": "https://zorvyn-finance-backend-y2ab.onrender.com", "description": "Production or http://localhost:8080" },
		{ "key": "accessToken", "value": "" },
		{ "key": "refreshToken", "value": "" },
		{ "key": "activeUserId", "value": "" },
		{ "key": "activeRecordId", "value": "" }
	]
}
