							"mode": "raw",
							"raw": "{\n    \"name\": \"Test Analyst\",\n    \"email\": \"test.analyst@example.com\",\n    \"password\": \"password123\",\n    \"role\": \"ANALYST\",\n    \"status\": \"ACTIVE\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/api/users", "host": [ "{{baseUrl}}" ], "path": [ "api", "users" ] }
					}
				},
				{
