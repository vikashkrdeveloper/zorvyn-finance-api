				},
				{
					"name": "Update User",
					"request": {
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated Name\",\n    \"role\": \"ADMIN\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/api/users/{{activeUserId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "users", "{{activeUserId}}" ] }
					}
				},
				{
					"name": "Delete User (Soft Delete)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/users/{{activeUserId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "users", "{{activeUserId}}" ] }
					}
				}
			]
		},
